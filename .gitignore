# Large pySCENIC input/resource artifacts are deposited or archived separately.
pySCENIC/data/pyscenic_input/*.h5ad
pySCENIC/resources/pyscenic/*.feather
pySCENIC/resources/pyscenic/*.tbl

# scRNA-seq raw input (Cell Ranger matrices) is an external artifact.
scRNA_pipeline/data/raw/*
!scRNA_pipeline/data/raw/README.md
!scRNA_pipeline/data/raw/CellRanger_Outputs/
scRNA_pipeline/data/raw/CellRanger_Outputs/*
!scRNA_pipeline/data/raw/samplesheet.csv

# Pipeline outputs are regenerated by the scripts and are not committed.
# Nothing under results/ is committed -- the few files that pipeline stages
# actually depend on as inputs live under their owning module instead:
# metabolomics/data/processed/ and hdWGCNA/resources/ (see those modules'
# READMEs).
results/

# Internal audit trail, one-off migration/submission tooling, and their tests --
# kept locally, not part of the public submission.
analysis_provenance/

# Pipeline run logs (written to the working directory by pipeline scripts)
*.log

# Quarto report inputs pulled in for local rendering are external artifacts
# (scRNA Seurat object, QC CSVs, and metabolomics matrices for
# plot_manuscript_figures.qmd). Not part of the source submission -- what
# belongs here is documented in reports/README.md instead of a README file
# inside this directory.
reports/data/

# Per-analysis input tables for statistical_analysis/statistical_analysis.qmd.
# Committed in full (one row per clone / brain / cell). The source measurement
# sheets and the table-preparation code are not part of the public repo (kept
# under analysis_provenance/, which is git-ignored).
statistical_analysis/data/*
!statistical_analysis/data/README.md
!statistical_analysis/data/*.csv

# Quarto build sidecars -- the rendered .html in reports/ is committed, these are not
.quarto/
**/*_files/
**/*_cache/
**/.jupyter_cache/
**/*.rmarkdown

# macOS metadata
.DS_Store
